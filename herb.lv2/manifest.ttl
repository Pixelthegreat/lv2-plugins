@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<http://fanfavoritessofar.com/herb>
	a lv2:Plugin ;
	lv2:binary <herb.so> ;
	rdfs:seeAlso <herb.ttl> .

<http://fanfavoritessofar.com/herb#ui-x11>
	a ui:X11UI ;
	lv2:binary <herb-ui.so> ;
	rdfs:seeAlso <herb-ui.ttl> .
