@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<http://fanfavoritessofar.com/chiptune>
	a lv2:Plugin ;
	lv2:binary <chiptune.so> ;
	rdfs:seeAlso <chiptune.ttl> .

<http://fanfavoritessofar.com/chiptune#ui-x11>
	a ui:X11UI ;
	lv2:binary <chiptune-ui.so> ;
	rdfs:seeAlso <chiptune-ui.ttl> .
